N8N_PORT=5678
N8N_HOST=localhost
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_postgres_password_here

OPENAI_API_KEY=your_openai_api_key_here

# Application database (separate from n8n's own database)
APP_DB=resume_app

# Backend (FastAPI) settings. All optional; defaults shown.
# DATABASE_URL=postgresql://user:password@host:5432/resume_app   # overrides the POSTGRES_*/APP_DB parts
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# OPENAI_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# FILES_DIR=files                         # uploaded PDFs; relative to the repo root
# CORS_ORIGINS=http://localhost:3000      # comma-separated
