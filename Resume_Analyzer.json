              "content": "=Resume Text:\n\n{{ $json.resume_text }}"
            },
            {
              "role": "system",
              "content": "You are a resume data extraction system.\n\nExtract the candidate's name and email address from the resume text.\n\nReturn ONLY valid JSON.\n\nUse exactly this structure:\n\n{\n  \"name\": \"\",\n  \"email\": \"\"\n}\n\nRules:\n- name must be the candidate's full name as written in the resume.\n- email must be the candidate's email address as written in the resume.\n- If a value cannot be found, return an empty string.\n- Do not guess or invent information.\n- Do not include markdown.\n- Do not include explanations outside the JSON."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
