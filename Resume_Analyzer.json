          "id": "MS4V5VyyzauD9PLO",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $json.output[0].content[0].text;\n\nlet resumeData;\n\ntry {\n  resumeData = JSON.parse(text);\n} catch (error) {\n  throw new Error('OpenAI returned invalid JSON: ' + text);\n}\n\nconst input = $('Prepare Resume').item.json;\n\nreturn [\n  {\n    json: {\n      name: resumeData.name || '',\n      email: resumeData.email || '',\n      resume_text: input.resume_text || ''\n    }\n  }\n];"
      },
